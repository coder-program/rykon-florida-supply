# ── Banco de dados ──────────────────────────────────────────────────
# Em produção: use a connection string do Render (copiada do dashboard)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/florida_hortifruti"

# ── JWT ─────────────────────────────────────────────────────────────
# OBRIGATÓRIO: gere um valor aleatório forte para produção
# Sugestão: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="TROQUE_POR_UM_VALOR_ALEATORIO_FORTE_EM_PRODUCAO"
JWT_EXPIRES_IN="8h"

# ── URLs ─────────────────────────────────────────────────────────────
# URL pública desta API (fallback do QR se PWA_PUBLIC_URL não existir)
# Ex: https://florida-hortifruti-api.onrender.com
APP_PUBLIC_URL="https://SUA_URL_DO_RENDER_AQUI"

# URL do PWA — o QR da etiqueta abre o pedido aqui
# Local: http://localhost:5200
# Prod: https://florida-hortifruti-pwa.vercel.app
PWA_PUBLIC_URL="http://localhost:5200"

# Origens permitidas no CORS (URLs dos frontends Vercel, separadas por vírgula)
# Ex: https://florida-admin.vercel.app,https://florida-pwa.vercel.app
ALLOWED_ORIGINS="https://SEU_ADMIN.vercel.app,https://SEU_PWA.vercel.app"

# ── Porta ────────────────────────────────────────────────────────────
PORT=3000
