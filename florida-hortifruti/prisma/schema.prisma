// Schema do banco de dados - Sistema de Pedidos, Vendas e Controle de Estoque
// Flórida Hortifruti

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USUÁRIOS E PERMISSÕES
// ==========================================

enum PapelUsuario {
  VENDEDOR
  ADMINISTRATIVO
  ADMINISTRADOR
  MOTORISTA
  CLIENTE
}

model Usuario {
  id        String       @id @default(uuid())
  nome      String
  email     String       @unique
  senhaHash String
  papel     PapelUsuario
  ativo     Boolean      @default(true)
  criadoEm  DateTime     @default(now())

  pedidosCriados          Pedido[]                     @relation("VendedorPedido")
  pedidosEntrega          Pedido[]                     @relation("EntregadorPedido")
  cliente                 Cliente?
  ajustesEstoque          MovimentacaoEstoque[]
  comprasEstoque          CompraEstoque[]
  historicoPrecos         HistoricoPreco[]
  precosCliente           PrecoCliente[]
  logs                    LogAuditoria[]
  solicitacoesEnviadas    SolicitacaoAlteracaoPedido[] @relation("SolicitanteAlteracao")
  solicitacoesRespondidas SolicitacaoAlteracaoPedido[] @relation("ResponsavelAlteracao")
  comprovantesEntrega     ComprovanteEntrega[]

  @@map("usuarios")
}

enum TipoEntidadeEndereco {
  CLIENTE
  USUARIO
  FORNECEDOR
}

enum TipoEndereco {
  PRINCIPAL
  ENTREGA
  COBRANCA
}

model Estado {
  id      String   @id @default(uuid())
  nome    String   @unique
  sigla   String   @unique
  cidades Cidade[]

  @@map("estados")
}

model Cidade {
  id        String     @id @default(uuid())
  nome      String
  estadoId  String
  estado    Estado     @relation(fields: [estadoId], references: [id])
  enderecos Endereco[]

  @@unique([nome, estadoId])
  @@index([estadoId])
  @@map("cidades")
}

model Endereco {
  id              String               @id @default(uuid())
  entidadeTipo    TipoEntidadeEndereco
  entidadeId      String
  tipo            TipoEndereco         @default(PRINCIPAL)
  principal       Boolean              @default(true)
  cep             String?
  logradouro      String
  numero          String?
  complemento     String?
  bairro          String?
  cidadeId        String
  cidade          Cidade               @relation(fields: [cidadeId], references: [id])
  pontoReferencia String?
  criadoEm        DateTime             @default(now())
  atualizadoEm    DateTime             @updatedAt

  @@index([entidadeTipo, entidadeId])
  @@map("enderecos")
}

// ==========================================
// CLIENTES
// ==========================================

enum StatusConviteCliente {
  NAO_CONVIDADO
  CONVITE_ENVIADO
  ATIVO
}

model Cliente {
  id                  String                @id @default(uuid())
  razaoSocialOuNome   String
  nomeFantasia        String?
  cnpjCpf             String                @unique
  telefone            String?
  whatsapp            String?
  email               String?
  responsavelContato  String?
  condicaoPagamento   String?
  formaPagamentoUsual String?
  necessitaNF         Boolean               @default(false)
  observacoes         String?
  ativo               Boolean               @default(true)
  criadoEm            DateTime              @default(now())

  usuarioId            String?               @unique
  usuario              Usuario?              @relation(fields: [usuarioId], references: [id])
  statusConvite        StatusConviteCliente  @default(NAO_CONVIDADO)
  tokenConvite         String?               @unique
  tokenConviteExpiraEm DateTime?

  pedidos         Pedido[]
  precos          PrecoCliente[]
  historicoPrecos HistoricoPreco[]

  @@map("clientes")
}

// ==========================================
// PRODUTOS
// ==========================================

enum UnidadeVenda {
  KG
  CAIXA
  UNIDADE
  SACO
  BANDEJA
  DUZIA
}

model Categoria {
  id       String    @id @default(uuid())
  nome     String    @unique
  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id                         String       @id @default(uuid())
  codigoInterno              String       @unique
  nome                       String
  categoriaId                String?
  categoria                  Categoria?   @relation(fields: [categoriaId], references: [id])
  unidadeVenda               UnidadeVenda @default(CAIXA)
  precoSugerido              Decimal      @db.Decimal(10, 2)
  custo                      Decimal?     @db.Decimal(10, 2)
  estoqueMinimo              Decimal?     @db.Decimal(10, 2)
  limiteEstoqueBaixo         Decimal?     @db.Decimal(10, 2)
  exibirQuantidadeAproximada Boolean      @default(false)
  exibirNoPortalCliente      Boolean      @default(true)
  ativo                      Boolean      @default(true)
  criadoEm                   DateTime     @default(now())

  itensPedido     ItemPedido[]
  movimentacoes   MovimentacaoEstoque[]
  itensCompra     ItemCompraEstoque[]
  historicoPrecos HistoricoPreco[]
  precosCliente   PrecoCliente[]

  @@map("produtos")
}

model PrecoCliente {
  id              String   @id @default(uuid())
  clienteId       String
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  produtoId       String
  produto         Produto  @relation(fields: [produtoId], references: [id])
  precoUnitario   Decimal  @db.Decimal(10, 2)
  atualizadoEm    DateTime @updatedAt
  atualizadoPorId String
  atualizadoPor   Usuario  @relation(fields: [atualizadoPorId], references: [id])

  @@unique([clienteId, produtoId])
  @@map("precos_cliente")
}

// ==========================================
// PEDIDOS
// ==========================================

enum StatusPedido {
  AGUARDANDO_APROVACAO
  APROVADO
  REJEITADO
  EM_SEPARACAO
  PRONTO_PARA_ENTREGA
  EM_ENTREGA
  ENTREGUE
  CANCELADO
}

enum OrigemPedido {
  VENDEDOR
  CLIENTE
}

enum FormaPagamento {
  PIX
  BOLETO
  DINHEIRO
  OUTROS
}

enum StatusPagamento {
  PAGO
  EM_ABERTO
  VENCIDO
}

model Pedido {
  id        String  @id @default(uuid())
  numero    Int     @unique @default(autoincrement())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  vendedorId String?
  vendedor   Usuario? @relation("VendedorPedido", fields: [vendedorId], references: [id])

  entregadorId String?
  entregador   Usuario? @relation("EntregadorPedido", fields: [entregadorId], references: [id])

  origem OrigemPedido @default(VENDEDOR)
  data   DateTime     @default(now())

  status StatusPedido @default(AGUARDANDO_APROVACAO)

  subtotal            Decimal  @db.Decimal(10, 2)
  valorFrete          Decimal  @default(0) @db.Decimal(10, 2)
  freteInclusoNoPreco Boolean  @default(false)
  descontoValor       Decimal  @default(0) @db.Decimal(10, 2)
  descontoPercentual  Decimal? @db.Decimal(5, 2)
  totalFinal          Decimal  @db.Decimal(10, 2)

  formaPagamento    FormaPagamento
  dataVencimento    DateTime?
  condicaoNegociada String?
  statusPagamento   StatusPagamento @default(EM_ABERTO)

  necessitaNF Boolean @default(false)
  observacoes String?

  entregueEm        DateTime?
  recebidoPor       String?
  observacaoEntrega String?
  fotoEntrega       String?   @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  caixasEtiquetadas Int @default(0)

  itens                 ItemPedido[]
  movimentacoes         MovimentacaoEstoque[]
  etiqueta              Etiqueta?
  solicitacoesAlteracao SolicitacaoAlteracaoPedido[]
  comprovanteEntrega    ComprovanteEntrega?

  @@index([entregadorId, status])
  @@map("pedidos")
}

model ItemPedido {
  id            String  @id @default(uuid())
  pedidoId      String
  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto @relation(fields: [produtoId], references: [id])
  quantidade    Decimal @db.Decimal(10, 2)
  valorUnitario Decimal @db.Decimal(10, 2)
  valorTotal    Decimal @db.Decimal(10, 2)

  @@map("itens_pedido")
}

model ComprovanteEntrega {
  id            String   @id @default(uuid())
  pedidoId      String   @unique
  pedido        Pedido   @relation(fields: [pedidoId], references: [id])
  motoristaId   String
  motorista     Usuario  @relation(fields: [motoristaId], references: [id])
  fotoUrl       String   @db.Text
  nomeRecebedor String
  dataHora      DateTime @default(now())
  latitude      Float?
  longitude     Float?
  observacao    String?

  @@map("comprovantes_entrega")
}

model HistoricoPreco {
  id            String   @id @default(uuid())
  produtoId     String
  produto       Produto  @relation(fields: [produtoId], references: [id])
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  clienteId     String?
  cliente       Cliente? @relation(fields: [clienteId], references: [id])
  valorAnterior Decimal  @db.Decimal(10, 2)
  valorNovo     Decimal  @db.Decimal(10, 2)
  data          DateTime @default(now())

  @@map("historico_precos")
}

// ==========================================
// ESTOQUE
// ==========================================

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
}

model MovimentacaoEstoque {
  id            String           @id @default(uuid())
  produtoId     String
  produto       Produto          @relation(fields: [produtoId], references: [id])
  tipo          TipoMovimentacao
  quantidade    Decimal          @db.Decimal(10, 2)
  origem        String
  pedidoId      String?
  pedido        Pedido?          @relation(fields: [pedidoId], references: [id])
  fornecedor    String?
  custoTotal    Decimal?         @db.Decimal(10, 2)
  custoUnitario Decimal?         @db.Decimal(10, 2)
  motivoAjuste  String?
  usuarioId     String
  usuario       Usuario          @relation(fields: [usuarioId], references: [id])
  observacao    String?
  data          DateTime         @default(now())
  itemCompra    ItemCompraEstoque?

  @@map("movimentacoes_estoque")
}

model CompraEstoque {
  id            String              @id @default(uuid())
  fornecedor    String
  valorFrete    Decimal             @default(0) @db.Decimal(10, 2)
  valorComissao Decimal             @default(0) @db.Decimal(10, 2)
  observacao    String?
  data          DateTime            @default(now())
  usuarioId     String
  usuario       Usuario             @relation(fields: [usuarioId], references: [id])
  itens         ItemCompraEstoque[]

  @@map("compras_estoque")
}

model ItemCompraEstoque {
  id                    String               @id @default(uuid())
  compraId              String
  compra                CompraEstoque        @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produtoId             String
  produto               Produto              @relation(fields: [produtoId], references: [id])
  quantidade            Decimal              @db.Decimal(10, 2)
  valorProdutoInformado Decimal              @db.Decimal(10, 2)
  rateioFrete           Decimal              @db.Decimal(10, 2)
  rateioComissao        Decimal              @db.Decimal(10, 2)
  custoUnitarioFinal    Decimal              @db.Decimal(12, 4)
  movimentacaoId        String?              @unique
  movimentacao          MovimentacaoEstoque? @relation(fields: [movimentacaoId], references: [id])

  @@map("itens_compra_estoque")
}

// ==========================================
// ETIQUETAS / QR CODE
// ==========================================

enum StatusSolicitacaoAlteracao {
  PENDENTE
  APROVADA
  NEGADA
}

model SolicitacaoAlteracaoPedido {
  id              String                     @id @default(uuid())
  pedidoId        String
  pedido          Pedido                     @relation(fields: [pedidoId], references: [id])
  solicitanteId   String
  solicitante     Usuario                    @relation("SolicitanteAlteracao", fields: [solicitanteId], references: [id])
  status          StatusSolicitacaoAlteracao @default(PENDENTE)
  itens           Json
  observacao      String?
  resposta        String?
  respondidoPorId String?
  respondidoPor   Usuario?                   @relation("ResponsavelAlteracao", fields: [respondidoPorId], references: [id])
  criadoEm        DateTime                   @default(now())
  respondidoEm    DateTime?

  @@index([pedidoId, status])
  @@index([status, criadoEm])
  @@map("solicitacoes_alteracao_pedido")
}

model Etiqueta {
  id             String   @id @default(uuid())
  pedidoId       String   @unique
  pedido         Pedido   @relation(fields: [pedidoId], references: [id])
  tokenPublico   String   @unique @default(uuid())
  ocultarValores Boolean  @default(true)
  geradaEm       DateTime @default(now())
  reimpressoes   Int      @default(0)

  @@map("etiquetas")
}

// ==========================================
// AUDITORIA
// ==========================================

model LogAuditoria {
  id         String   @id @default(uuid())
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  acao       String
  entidade   String
  entidadeId String
  detalhes   Json?
  data       DateTime @default(now())

  @@map("logs_auditoria")
}
