// Schema do banco de dados - Sistema de Pedidos, Vendas e Controle de Estoque
// Flórida Hortifruti

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USUÁRIOS E PERMISSÕES
// ==========================================

enum PapelUsuario {
  VENDEDOR
  // Vendedor que também faz as compras (entrada de lote) e acompanha dashboard e metas
  SUPERVISOR
  // TV do salão: só leitura do dashboard e das metas
  VISAO_GERAL
  ADMINISTRATIVO
  ADMINISTRADOR
  MOTORISTA
  CLIENTE
  // Compra da Flórida para revender: só os próprios pedidos, clientes e devoluções, e o
  // estoque em caixas (sem custo)
  REVENDEDOR
}

model Usuario {
  id                  String       @id @default(uuid())
  nome                String
  email               String       @unique
  cpf                 String?      @unique
  dataNascimento      DateTime?
  telefone            String?
  whatsapp            String?
  enderecoPrincipalId String?      @unique
  enderecoPrincipal   Endereco?    @relation("EnderecoPrincipalUsuario", fields: [enderecoPrincipalId], references: [id], onDelete: SetNull)
  senhaHash           String
  papel               PapelUsuario
  ativo               Boolean      @default(true)
  criadoEm            DateTime     @default(now())

  pedidosCriados              Pedido[]                     @relation("VendedorPedido")
  pedidosEntrega              Pedido[]                     @relation("EntregadorPedido")
  cliente                     Cliente?
  clientesRevendedor          Cliente[]                    @relation("ClientesRevendedor")
  pushInscricoes              PushInscricao[]
  ajustesEstoque              MovimentacaoEstoque[]
  comprasEstoque              CompraEstoque[]
  historicoPrecos             HistoricoPreco[]
  precosCliente               PrecoCliente[]
  logs                        LogAuditoria[]
  solicitacoesEnviadas        SolicitacaoAlteracaoPedido[] @relation("SolicitanteAlteracao")
  solicitacoesRespondidas     SolicitacaoAlteracaoPedido[] @relation("ResponsavelAlteracao")
  comprovantesEntrega         ComprovanteEntrega[]
  pagamentosPedidoRegistrados PagamentoPedido[]

  investimentos          Investimento[]
  devolucoesInvestimento DevolucaoInvestimento[]

  @@map("usuarios")
}

enum TipoEntidadeEndereco {
  CLIENTE
  USUARIO
  FORNECEDOR
}

enum TipoEndereco {
  PRINCIPAL
  ENTREGA
  COBRANCA
}

model Estado {
  id      String   @id @default(uuid())
  nome    String   @unique
  sigla   String   @unique
  cidades Cidade[]

  @@map("estados")
}

model Cidade {
  id        String     @id @default(uuid())
  nome      String
  estadoId  String
  estado    Estado     @relation(fields: [estadoId], references: [id])
  enderecos Endereco[]

  @@unique([nome, estadoId])
  @@index([estadoId])
  @@map("cidades")
}

model Endereco {
  id                           String               @id @default(uuid())
  entidadeTipo                 TipoEntidadeEndereco
  entidadeId                   String
  tipo                         TipoEndereco         @default(PRINCIPAL)
  principal                    Boolean              @default(true)
  cep                          String?
  logradouro                   String
  numero                       String?
  complemento                  String?
  bairro                       String?
  cidadeId                     String
  cidade                       Cidade               @relation(fields: [cidadeId], references: [id])
  pontoReferencia              String?
  criadoEm                     DateTime             @default(now())
  atualizadoEm                 DateTime             @updatedAt
  usuariosComEnderecoPrincipal Usuario[]            @relation("EnderecoPrincipalUsuario")

  @@index([entidadeTipo, entidadeId])
  @@map("enderecos")
}

// ==========================================
// CLIENTES
// ==========================================

enum StatusConviteCliente {
  NAO_CONVIDADO
  CONVITE_ENVIADO
  ATIVO
}

model Cliente {
  id                  String   @id @default(uuid())
  // Cliente do revendedor: só ele vê; nulo = cliente da Flórida
  revendedorId        String?
  revendedor          Usuario? @relation("ClientesRevendedor", fields: [revendedorId], references: [id])
  razaoSocialOuNome   String
  nomeFantasia        String?
  cnpjCpf             String   @unique
  telefone            String?
  whatsapp            String?
  email               String?
  responsavelContato  String?
  condicaoPagamento   String?
  formaPagamentoUsual String?
  necessitaNF         Boolean  @default(false)
  observacoes         String?
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now())

  usuarioId            String?              @unique
  usuario              Usuario?             @relation(fields: [usuarioId], references: [id])
  statusConvite        StatusConviteCliente @default(NAO_CONVIDADO)
  tokenConvite         String?              @unique
  tokenConviteExpiraEm DateTime?

  pedidos         Pedido[]
  precos          PrecoCliente[]
  historicoPrecos HistoricoPreco[]
  notificacoes    NotificacaoCliente[]

  @@index([revendedorId])
  @@map("clientes")
}

// ==========================================
// PRODUTOS
// ==========================================

enum UnidadeVenda {
  KG
  CAIXA
  UNIDADE
  SACO
  BANDEJA
  DUZIA
}

model Categoria {
  id       String    @id @default(uuid())
  nome     String    @unique
  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id                         String       @id @default(uuid())
  codigoInterno              String       @unique
  nome                       String
  categoriaId                String?
  categoria                  Categoria?   @relation(fields: [categoriaId], references: [id])
  unidadeVenda               UnidadeVenda @default(CAIXA)
  precoSugerido              Decimal      @db.Decimal(10, 2)
  custo                      Decimal?     @db.Decimal(10, 2)
  estoqueMinimo              Decimal?     @db.Decimal(10, 2)
  limiteEstoqueBaixo         Decimal?     @db.Decimal(10, 2)
  exibirQuantidadeAproximada Boolean      @default(false)
  exibirNoPortalCliente      Boolean      @default(true)
  ativo                      Boolean      @default(true)
  criadoEm                   DateTime     @default(now())

  itensPedido     ItemPedido[]
  itensPedidoLote ItemPedidoLote[]
  movimentacoes   MovimentacaoEstoque[]
  itensCompra     ItemCompraEstoque[]
  historicoPrecos HistoricoPreco[]
  precosCliente   PrecoCliente[]
  lotesProduto    LoteProduto[]

  @@map("produtos")
}

model PrecoCliente {
  id              String   @id @default(uuid())
  clienteId       String
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  produtoId       String
  produto         Produto  @relation(fields: [produtoId], references: [id])
  precoUnitario   Decimal  @db.Decimal(10, 2)
  atualizadoEm    DateTime @updatedAt
  atualizadoPorId String
  atualizadoPor   Usuario  @relation(fields: [atualizadoPorId], references: [id])

  @@unique([clienteId, produtoId])
  @@map("precos_cliente")
}

// ==========================================
// PEDIDOS
// ==========================================

enum StatusPedido {
  AGUARDANDO_APROVACAO
  APROVADO
  REJEITADO
  EM_SEPARACAO
  PRONTO_PARA_ENTREGA
  EM_ENTREGA
  ENTREGUE
  CANCELADO
}

enum OrigemPedido {
  VENDEDOR
  CLIENTE
}

enum FormaPagamento {
  PIX
  DINHEIRO
  FATURADO
  LINK_PAGAMENTO
  CARTAO_CREDITO
  CARTAO_DEBITO
  // Antigas: Boleto virou Faturado (migração) e Outros fica só nos pedidos já registrados
  BOLETO
  OUTROS
}

enum StatusPagamento {
  PAGO
  EM_ABERTO
  VENCIDO
}

model Pedido {
  id        String  @id @default(uuid())
  numero    Int     @unique @default(autoincrement())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  vendedorId String?
  vendedor   Usuario? @relation("VendedorPedido", fields: [vendedorId], references: [id])

  entregadorId String?
  entregador   Usuario? @relation("EntregadorPedido", fields: [entregadorId], references: [id])

  origem OrigemPedido @default(VENDEDOR)
  data   DateTime     @default(now())

  status StatusPedido @default(AGUARDANDO_APROVACAO)

  subtotal            Decimal  @db.Decimal(10, 2)
  valorFrete          Decimal  @default(0) @db.Decimal(10, 2)
  freteInclusoNoPreco Boolean  @default(false)
  descontoValor       Decimal  @default(0) @db.Decimal(10, 2)
  descontoPercentual  Decimal? @db.Decimal(5, 2)
  totalFinal          Decimal  @db.Decimal(10, 2)

  formaPagamento    FormaPagamento
  dataVencimento    DateTime?
  condicaoNegociada String?
  statusPagamento   StatusPagamento @default(EM_ABERTO)

  necessitaNF Boolean @default(false)
  observacoes String?

  entregueEm        DateTime?
  recebidoPor       String?
  observacaoEntrega String?
  fotoEntrega       String?   @db.Text
  // Pedido de revendedor: preço que ele cobra do cliente dele, por produto ({ produtoId: valor }).
  // Só para o controle dele; os itens levam o preço da Flórida para ele
  precosRevenda     Json?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  caixasEtiquetadas Int @default(0)

  itens                 ItemPedido[]
  itensLote             ItemPedidoLote[]
  movimentacoes         MovimentacaoEstoque[]
  etiqueta              Etiqueta?
  solicitacoesAlteracao SolicitacaoAlteracaoPedido[]
  comprovanteEntrega    ComprovanteEntrega?
  notificacoes          NotificacaoCliente[]
  pagamentos            PagamentoPedido[]
  historicoStatus       HistoricoStatusPedido[]

  @@index([entregadorId, status])
  @@map("pedidos")
}

// Timeline de status do pedido, usada no acompanhamento de rota do portal do cliente
model HistoricoStatusPedido {
  id         String       @id @default(uuid())
  pedidoId   String
  pedido     Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  status     StatusPedido
  alteradoEm DateTime     @default(now())

  @@index([pedidoId, alteradoEm])
  @@map("historico_status_pedido")
}

// Pagamentos parciais de um pedido a prazo - saldo devedor = totalFinal - soma(pagamentos)
model PagamentoPedido {
  id             String          @id @default(uuid())
  pedidoId       String
  pedido         Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  valor          Decimal         @db.Decimal(10, 2)
  data           DateTime        @default(now())
  formaPagamento FormaPagamento?
  observacao     String?
  usuarioId      String
  usuario        Usuario         @relation(fields: [usuarioId], references: [id])
  criadoEm       DateTime        @default(now())

  @@index([pedidoId])
  @@map("pagamentos_pedido")
}

model ItemPedido {
  id            String       @id @default(uuid())
  pedidoId      String
  pedido        Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto      @relation(fields: [produtoId], references: [id])
  // Lote escolhido pelo vendedor; nulo = baixa automática do lote mais antigo
  loteId        String?
  lote          LoteProduto? @relation(fields: [loteId], references: [id])
  quantidade    Decimal      @db.Decimal(10, 2)
  valorUnitario Decimal      @db.Decimal(10, 2)
  valorTotal    Decimal      @db.Decimal(10, 2)

  @@map("itens_pedido")
}

model ItemPedidoLote {
  id            String      @id @default(uuid())
  pedidoId      String
  pedido        Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto     @relation(fields: [produtoId], references: [id])
  loteId        String
  lote          LoteProduto @relation(fields: [loteId], references: [id])
  quantidade    Decimal     @db.Decimal(10, 2)
  valorUnitario Decimal     @db.Decimal(10, 2)
  valorTotal    Decimal     @db.Decimal(10, 2)

  @@index([pedidoId, produtoId])
  @@map("itens_pedido_lote")
}

model ComprovanteEntrega {
  id            String   @id @default(uuid())
  pedidoId      String   @unique
  pedido        Pedido   @relation(fields: [pedidoId], references: [id])
  motoristaId   String
  motorista     Usuario  @relation(fields: [motoristaId], references: [id])
  fotoUrl       String   @db.Text
  nomeRecebedor String
  dataHora      DateTime @default(now())
  latitude      Float?
  longitude     Float?
  observacao    String?

  @@map("comprovantes_entrega")
}

model HistoricoPreco {
  id            String   @id @default(uuid())
  produtoId     String
  produto       Produto  @relation(fields: [produtoId], references: [id])
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  clienteId     String?
  cliente       Cliente? @relation(fields: [clienteId], references: [id])
  valorAnterior Decimal  @db.Decimal(10, 2)
  valorNovo     Decimal  @db.Decimal(10, 2)
  data          DateTime @default(now())

  @@map("historico_precos")
}

// ==========================================
// ESTOQUE
// ==========================================

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
}

model MovimentacaoEstoque {
  id            String                    @id @default(uuid())
  produtoId     String
  produto       Produto                   @relation(fields: [produtoId], references: [id])
  tipo          TipoMovimentacao
  quantidade    Decimal                   @db.Decimal(10, 2)
  origem        String
  pedidoId      String?
  pedido        Pedido?                   @relation(fields: [pedidoId], references: [id])
  fornecedor    String?
  custoTotal    Decimal?                  @db.Decimal(10, 2)
  custoUnitario Decimal?                  @db.Decimal(10, 2)
  motivoAjuste  String?
  usuarioId     String
  usuario       Usuario                   @relation(fields: [usuarioId], references: [id])
  observacao    String?
  data          DateTime                  @default(now())
  itemCompra    ItemCompraEstoque?
  lotes         MovimentacaoEstoqueLote[]

  @@map("movimentacoes_estoque")
}

model LoteProduto {
  id                   String   @id @default(uuid())
  produtoId            String
  produto              Produto  @relation(fields: [produtoId], references: [id])
  numero               String
  dataEntrada          DateTime @default(now())
  quantidadeInicial    Decimal  @db.Decimal(10, 2)
  quantidadeDisponivel Decimal  @db.Decimal(10, 2)
  valorUnitario        Decimal  @db.Decimal(10, 2)
  // Preço mínimo de venda por caixa, informado na entrada; só referência no pedido
  precoSugeridoVenda   Decimal? @db.Decimal(10, 2)
  observacao           String?
  ativo                Boolean  @default(true)
  criadoEm             DateTime @default(now())

  itensPedido       ItemPedidoLote[]
  itensSelecionados ItemPedido[]
  movimentacoesLote MovimentacaoEstoqueLote[]

  // Número do lote é único por produto e dia (ex.: 18/09 - lote 1), validado no EstoqueService
  @@index([produtoId, numero])
  @@index([produtoId, ativo, dataEntrada])
  @@map("lotes_produto")
}

model MovimentacaoEstoqueLote {
  id             String              @id @default(uuid())
  loteId         String
  lote           LoteProduto         @relation(fields: [loteId], references: [id])
  movimentacaoId String
  movimentacao   MovimentacaoEstoque @relation(fields: [movimentacaoId], references: [id], onDelete: Cascade)
  // Sempre positiva; o sentido (entrada/saída do lote) vem de saldoAntes -> saldoDepois
  quantidade     Decimal             @db.Decimal(10, 2)
  // Saldo do lote antes e depois do movimento (ex.: Lote 01: 130 -> 100)
  saldoAntes     Decimal?            @db.Decimal(10, 2)
  saldoDepois    Decimal?            @db.Decimal(10, 2)
  origem         String
  data           DateTime            @default(now())

  @@index([loteId, data])
  @@index([movimentacaoId])
  @@map("movimentacoes_estoque_lote")
}

// Cadastro de fornecedores, escolhidos na entrada de cada lote
model Fornecedor {
  id         String   @id @default(uuid())
  nome       String
  documento  String?
  telefone   String?
  observacao String?
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())

  compras CompraEstoque[]

  @@map("fornecedores")
}

model CompraEstoque {
  id            String              @id @default(uuid())
  // Nome gravado na compra; entradas antigas (antes do cadastro) só têm o nome
  fornecedor    String
  fornecedorId  String?
  fornecedorRef Fornecedor?         @relation(fields: [fornecedorId], references: [id])
  valorFrete    Decimal             @default(0) @db.Decimal(10, 2)
  valorComissao Decimal             @default(0) @db.Decimal(10, 2)
  observacao    String?
  data          DateTime            @default(now())
  usuarioId     String
  usuario       Usuario             @relation(fields: [usuarioId], references: [id])
  itens         ItemCompraEstoque[]

  @@map("compras_estoque")
}

model ItemCompraEstoque {
  id                    String               @id @default(uuid())
  compraId              String
  compra                CompraEstoque        @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produtoId             String
  produto               Produto              @relation(fields: [produtoId], references: [id])
  quantidade            Decimal              @db.Decimal(10, 2)
  valorProdutoInformado Decimal              @db.Decimal(10, 2)
  rateioFrete           Decimal              @db.Decimal(10, 2)
  rateioComissao        Decimal              @db.Decimal(10, 2)
  custoUnitarioFinal    Decimal              @db.Decimal(12, 4)
  movimentacaoId        String?              @unique
  movimentacao          MovimentacaoEstoque? @relation(fields: [movimentacaoId], references: [id])

  @@map("itens_compra_estoque")
}

// ==========================================
// ETIQUETAS / QR CODE
// ==========================================

enum StatusSolicitacaoAlteracao {
  PENDENTE
  APROVADA
  NEGADA
}

model SolicitacaoAlteracaoPedido {
  id              String                     @id @default(uuid())
  pedidoId        String
  pedido          Pedido                     @relation(fields: [pedidoId], references: [id])
  solicitanteId   String
  solicitante     Usuario                    @relation("SolicitanteAlteracao", fields: [solicitanteId], references: [id])
  status          StatusSolicitacaoAlteracao @default(PENDENTE)
  itens           Json
  observacao      String?
  resposta        String?
  respondidoPorId String?
  respondidoPor   Usuario?                   @relation("ResponsavelAlteracao", fields: [respondidoPorId], references: [id])
  criadoEm        DateTime                   @default(now())
  respondidoEm    DateTime?

  @@index([pedidoId, status])
  @@index([status, criadoEm])
  @@map("solicitacoes_alteracao_pedido")
}

model Etiqueta {
  id             String    @id @default(uuid())
  pedidoId       String    @unique
  pedido         Pedido    @relation(fields: [pedidoId], references: [id])
  tokenPublico   String    @unique @default(uuid())
  ocultarValores Boolean   @default(true)
  geradaEm       DateTime  @default(now())
  reimpressoes   Int       @default(0)
  dataEmbalagem  DateTime?

  @@map("etiquetas")
}

// ==========================================
// AUDITORIA
// ==========================================

model NotificacaoCliente {
  id           String    @id @default(uuid())
  clienteId    String
  cliente      Cliente   @relation(fields: [clienteId], references: [id])
  pedidoId     String?
  pedido       Pedido?   @relation(fields: [pedidoId], references: [id])
  tipo         String
  titulo       String
  mensagem     String
  agendadaPara DateTime?
  enviadaEm    DateTime?
  lidaEm       DateTime?
  status       String    @default("PENDENTE")
  criadoEm     DateTime  @default(now())

  @@index([clienteId, status, agendadaPara])
  @@map("notificacoes_cliente")
}

// Inscrição de push do navegador/celular (Web Push) — usada no aviso "pedido a caminho"
model PushInscricao {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
  @@map("push_inscricoes")
}

model LogAuditoria {
  id         String   @id @default(uuid())
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  acao       String
  entidade   String
  entidadeId String
  detalhes   Json?
  data       DateTime @default(now())

  @@map("logs_auditoria")
}

// Meta diária de lucro: valor base com histórico (cada valor vale a partir de uma data)
model MetaValor {
  id           String   @id @default(uuid())
  valor        Decimal  @db.Decimal(10, 2)
  vigenteDesde DateTime @db.Date
  criadoPorId  String?
  criadoEm     DateTime @default(now())

  @@index([vigenteDesde])
  @@map("metas_valor")
}

// Dias sem meta (feriados, dias sem operação). Domingos já são ignorados automaticamente.
model MetaDiaSemMeta {
  id       String   @id @default(uuid())
  data     DateTime @unique @db.Date
  motivo   String?
  criadoEm DateTime @default(now())

  @@map("metas_dias_sem_meta")
}

// ==========================================
// INVESTIMENTOS (aportes de sócios na empresa)
// ==========================================

model Investimento {
  id        String   @id @default(uuid())
  // Quem fez o aporte
  nome      String
  data      DateTime
  valor     Decimal  @db.Decimal(12, 2)
  motivo    String
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  criadoEm  DateTime @default(now())

  // Status (falta devolver / parcial / devolvido) sai da soma das devoluções
  devolucoes DevolucaoInvestimento[]

  @@map("investimentos")
}

model DevolucaoInvestimento {
  id             String       @id @default(uuid())
  investimentoId String
  investimento   Investimento @relation(fields: [investimentoId], references: [id], onDelete: Cascade)
  valor          Decimal      @db.Decimal(12, 2)
  data           DateTime
  observacao     String?
  usuarioId      String
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])
  criadoEm       DateTime     @default(now())

  @@index([investimentoId])
  @@map("devolucoes_investimento")
}
