{
  "name": "florida-hortifruti-sistemas",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint": "node scripts/run-all.mjs lint",
    "typecheck": "node scripts/run-all.mjs typecheck",
    "test": "node scripts/run-all.mjs test",
    "audit": "node scripts/run-all.mjs audit --audit-level=low",
    "audit:prod": "node scripts/run-all.mjs audit --omit=dev --audit-level=low",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "prettier --write \"florida-hortifruti/{src,prisma,test}/**/*.{ts,js,cjs,json}\" \"florida-hortifruti-*/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"florida-hortifruti/{src,prisma,test}/**/*.{ts,js,cjs,json}\" \"florida-hortifruti-*/src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.6"
  }
}
