{
  "framework": null,
  "installCommand": "echo \"dependências instaladas por sistema no build\"",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "https://floridahortifruti.com.br/acessar", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/vendedor/:path*", "destination": "/vendedor/index.html" },
    { "source": "/motorista/:path*", "destination": "/motorista/index.html" },
    { "source": "/cliente/:path*", "destination": "/cliente/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Frame-Options", "value": "DENY" }]
    },
    {
      "source": "/:perfil/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/:perfil/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
